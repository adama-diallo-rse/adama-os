# =====================================================================
# Adama OS, variables d'environnement de l'application web.
# Copier en .env.local pour le développement. Aucune valeur réelle ici.
# Inventaire complet et emplacement de chaque secret : docs/SECRETS.md
# =====================================================================

# --- L0-T6, origine publique -----------------------------------------
# Domaine propre. À poser dans Vercel sur le SEUL environnement Production
# (variable inlinée au build : en Preview elle ferait annoncer l'origine de
# production par chaque preview deploy).
NEXT_PUBLIC_SITE_URL=https://adamesg-os.fr

# --- L1, base de données ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://yccnnlasjcjuukithguk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement. Contourne la RLS : jamais exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- L3, adama.ai ----------------------------------------------------
OPENAI_API_KEY=
ADAMA_AI_MODEL=gpt-4o
# Garde-fou de débit de /api/chat (L8-T12). Valeurs par défaut si absent :
# 12 requêtes par fenêtre de 300 secondes et par adresse IP.
ADAMA_AI_RATE_LIMIT=
ADAMA_AI_RATE_WINDOW_S=

# --- L5-T2, feed Shipped multi-dépôts --------------------------------
# Repli si ecosystem_products est vide ou injoignable.
# Format : owner/repo:Produit:Division, séparés par des virgules.
GITHUB_REPOS=
# Un jeton finement configuré en LECTURE SEULE par propriétaire.
GITHUB_TOKEN_IROKO_SOFTWARE_GROUP=
GITHUB_TOKEN_ADAMA_DIALLO_RSE=
GITHUB_TOKEN_STRATA_ESG=
# Repli temporaire pendant la migration depuis l'ancien jeton unique.
GITHUB_TOKEN=

# --- L9, passerelles écosystème (lecture seule) ----------------------
# Origine des API produit. Une passerelle sans URL est simplement inactive :
# aucune métrique inventée, aucun appel deviné.
ECOSYSTEM_SCOPE_API_URL=
ECOSYSTEM_ESG_OPTIMIZER_API_URL=
# Secret du déclencheur de synchronisation (/api/ecosystem/sync).
# Vercel Cron envoie automatiquement "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# --- EH0, lettre SIGNAL (docs/LETTRE.md) ------------------------------
# Projet Supabase DEDIE a la lettre, jamais le projet partage ci-dessus :
# lib/lettre/config.ts refuse le meme hote et la meme cle (XINV-22).
LETTRE_SUPABASE_URL=
# Cle service_role du projet dedie. Serveur uniquement.
LETTRE_SUPABASE_SERVICE_ROLE_KEY=
# Cle API du compte Resend dedie a ADAMA, jamais celui qui porte
# esg-optimizer.fr (XDEC-37). Permission : Sending access, domaine lettre.
LETTRE_RESEND_API_KEY=
# Expediteur sur le sous-domaine dedie, jamais la racine ni un domaine STRATA.
LETTRE_EXPEDITEUR="Adama Diallo <signal@lettre.adamesg-os.fr>"
# Adresse de reponse. Defaut : le contact de lib/legal.ts.
LETTRE_REPONSE=
# Secret HMAC des empreintes et des liens de desinscription, 32 caracteres
# au moins. Le changer invalide tous les liens de desinscription deja envoyes.
LETTRE_SECRET=
# Comptes autorises sur /admin/lettre, separes par des virgules.
LETTRE_ADMINISTRATEURS=
# Palier gratuit Resend : 100 envois par jour.
LETTRE_PLAFOND_JOUR=100
# "ouverte" seulement apres la verification de bout en bout (XDEC-40).
LETTRE_COLLECTE=

# --- C1-T5, interrupteur de demonstration ----------------------------
# A 1, tout contenu de classe "demo" disparait du rendu serveur : la grille se
# recompose, elle ne laisse pas de case vide. A poser avant un envoi a un
# lecteur exigeant, puis a retirer. Vide ou absent : les valeurs de
# demonstration restent visibles, marquees comme telles.
ADAMA_HIDE_DEMO=

# --- L6, conversion --------------------------------------------------
NEXT_PUBLIC_CAL_LINK=

# --- L8, observabilité -----------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
BETTERSTACK_API_TOKEN=
BETTERSTACK_MONITOR_ID=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
